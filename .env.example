# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude AI — for email copy + pre-call briefs)
ANTHROPIC_API_KEY=sk-ant-...

# Apollo.io (prospect discovery + enrichment)
APOLLO_API_KEY=your-apollo-api-key

# Brevo (email sending + sequences)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=outreach@innago.com
BREVO_SENDER_NAME=Innago Sales

# Microsoft 365 (calendar booking)
MS365_CLIENT_ID=your-azure-app-client-id
MS365_CLIENT_SECRET=your-azure-app-client-secret
MS365_TENANT_ID=your-tenant-id
MS365_REDIRECT_URI=https://your-app.vercel.app/api/auth/ms365/callback

# Ahrefs (keyword + domain research)
AHREFS_API_KEY=your-ahrefs-api-key

# App config
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
INNAGO_SALES_EMAIL=sales@innago.com
